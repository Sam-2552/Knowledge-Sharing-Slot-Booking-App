# Knowledge Sharing Portal — environment template
# Copy to .env and adjust for local development.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=ksp_session

# Application
APP_HOST=0.0.0.0
APP_PORT=5000
APP_BASE_URL=http://localhost:5000

# SQLite path (relative to project root inside container)
DATABASE_PATH=instance/users.db

# MongoDB (comments & notifications)
MONGO_URI=mongodb://mongo:27017/ksp

# Redis (sessions, cache, magic-link tokens)
REDIS_URL=redis://redis:6379/0

# Mail (SMTP via mailhog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@ksp.local

# LDAP (corporate directory)
LDAP_URI=ldap://openldap:1389
LDAP_BIND_DN=cn=admin,dc=ksp,dc=local
LDAP_BIND_PASSWORD=adminpassword
LDAP_BASE_DN=ou=people,dc=ksp,dc=local

# OIDC (dex)
OIDC_ISSUER=http://dex:5556/dex
OIDC_CLIENT_ID=ksp-web
OIDC_CLIENT_SECRET=ksp-web-secret
OIDC_REDIRECT_BASE=http://localhost:5000

# Upload limits
MAX_UPLOAD_MB=16
UPLOAD_DIR=uploads
